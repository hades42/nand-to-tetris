// File name: projects/5/CPU.hdl
/**
 * The Hack Central Processing unit (CPU).
 * Parses the binary code in the instruction input and executes it according to the
 * Hack machine language specification. In the case of a C-instruction, computes the
 * function specified by the instruction. If the instruction specifies to read a memory
 * value, the inM input is expected to contain this value. If the instruction specifies
 * to write a value to the memory, sets the outM output to this value, sets the addressM
 * output to the target address, and asserts the writeM output (when writeM = 0, any
 * value may appear in outM).
 * If the reset input is 0, computes the address of the next instruction and sets the
 * pc output to that value. If the reset input is 1, sets pc to 0.
 * Note: The outM and writeM outputs are combinational: they are affected by the
 * instruction's execution during the current cycle. The addressM and pc outputs are
 * clocked: although they are affected by the instruction's execution, they commit to
 * their new values only in the next cycle.
 */
CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
	//// Replace this comment with your code.

    // Depend on instructions[15]
    // 0 -> A-instructions
    // 1 -> C-instructions
    Mux16(a=instruction, b=aluOutput, sel=instruction[15], out=aInstructOut);

    // Decide to load value to A Register 
    // Not(instruction[15]) or (instruction[15] and instruction[5])
    Not(in=instruction[15], out=aInstruction);
    And(a=instruction[15], b=instruction[5], out=aDestination);
    Or(a=aInstruction, b=aDestination, out=loadARegister);
    ARegister(in=aInstructOut, load=loadARegister, out=aRegisterOut, out[0..14]=addressM);

    // Decide A Register output or M value Input
    Mux16(a=aRegisterOut, b=inM, sel=instruction[12], out=aOrMOutput);

    // Indicate whether we write data to memory
    // It has to be a C instructions (instruction[15]) & instruction[3] (indicate M)
    And(a=instruction[15], b=instruction[3], out=writeM);

    // D Register
    // It has to be a C instruction and destination is D
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOutput, load=loadD, out=Dout);

    // ALU
    ALU(
        x=Dout, y=aOrMOutput, 
        zx=instruction[11],
        nx=instruction[10], 
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=aluOutput, zr=zero, ng=negative, out=outM
    );

    // Check for positive alu output 
    Not(in=zero, out=notZero);
    Not(in=negative, out=notNegative);
    And(a=notZero, b=notNegative, out=positive);

    // instruction[0] -> if this bit is turned and ALU output is positive -> jump 
    // instruction[1] -> if this bit is turned and ALU output is equal 0 -> jump 
    // instruction[2] -> if this bit is turned and ALU output is negative -> jump
    And(a=instruction[0], b=positive, out=jumpPositive);
    And(a=instruction[1], b=zero, out=jumpZero);
    And(a=instruction[2], b=negative, out=jumpNegative);
    
    // (instruction[0] & positive) or (instruction[1] & zero) or (instruction[2] & negative)
    Or(a=jumpPositive, b=jumpZero, out=jumpPostiveAndZero);
    Or(a=jumpPostiveAndZero, b=jumpNegative, out=jumpAllCase);

    // Jump only happen for C-instruction
    And(a=instruction[15], b=jumpAllCase, out=doJump);

    // Decide to jump or go to next instruction    
    DMux(in=true, sel=doJump, a=nextIns, b=loadIns);

    PC(in=aRegisterOut, reset=reset, load=loadIns, inc=nextIns, out[0..14]=pc);
}