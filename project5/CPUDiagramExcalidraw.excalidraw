      "isDeleted": false,
      "boundElements": [],
      "updated": 1783669244095,
      "link": null,
      "locked": false,
      "text": "Instruction[11..6] define the computation that we are doing",
      "fontSize": 12.896971785740154,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Instruction[11..6] define the computation that we are doing",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FPPl04S7qIITRnsx7bq_4",
      "type": "line",
      "x": 1430.0295961594259,
      "y": 728.8123891740354,
      "width": 589.645763326901,
      "height": 316.46339810417,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
