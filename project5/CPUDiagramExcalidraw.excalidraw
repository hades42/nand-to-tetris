    {
      "id": "a2HbkQxpjVSvB2W78JU0V",
      "type": "text",
      "x": 1256.656140781772,
      "y": 1012.66437829451,
      "width": 516.1977989430467,
      "height": 323.0286550469739,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
