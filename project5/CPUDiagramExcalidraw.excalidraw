    {
      "id": "Bm1sy12Bt9cVwQGOkk1xs",
      "type": "text",
      "x": 611.1501464575065,
      "y": 33.31418847024409,
      "width": 350.62722795679815,
      "height": 142.02629535297754,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 1948157876,
      "version": 1099,
      "versionNonce": 983619596,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783507765541,
      "link": null,
      "locked": false,
      "text": "Both A instructions and C-instructions arrive on\nthe the same single instructions[16]. Our job is\nto decide:\n 1. Does the value of A register come from the\ninsturction itself like @value, e.g @21 \n 2. Or Does the value of A register come from\nthe computation itself for example A = D - 1\n",
      "fontSize": 14.202629535297755,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Both A instructions and C-instructions arrive on the the same single instructions[16]. Our job is to decide:\n 1. Does the value of A register come from the insturction itself like @value, e.g @21 \n 2. Or Does the value of A register come from the computation itself for example A = D - 1\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
