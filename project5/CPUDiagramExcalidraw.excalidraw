    {
      "id": "xXk6Fc2enFgC7HTxfeyFh",
      "type": "text",
      "x": 1074.3086071623152,
      "y": -170.88390975546764,
      "width": 273.47852151598545,
      "height": 274.8352527470142,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 847522818,
      "version": 1781,
      "versionNonce": 2068687412,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783509481099,
      "link": null,
      "locked": false,
      "text": "Let say if we accept ALU instructions, not\nevery ALU instructions will change the value\nof A\nEg:\nA=D+M // dest includes A, we will load this\nvalue into A register\nD=D+M // dest doesn't include A, we will not\nload this value into A register\n\nSo the load bit here has to be a combination\nbetween\n    1. It has to be A instructions\n        or\n    2. If it is an ALU instruction, it has to\ninclude A as the destination\n\nNot(instruct[15]) or (instruct[15] and\ninstruct[5])",
      "fontSize": 12.21490012208952,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Let say if we accept ALU instructions, not every ALU instructions will change the value of A\nEg:\nA=D+M // dest includes A, we will load this value into A register\nD=D+M // dest doesn't include A, we will not load this value into A register\n\nSo the load bit here has to be a combination between\n    1. It has to be A instructions\n        or\n    2. If it is an ALU instruction, it has to include A as the destination\n\nNot(instruct[15]) or (instruct[15] and instruct[5])",
      "autoResize": false,
      "lineHeight": 1.25
    },
