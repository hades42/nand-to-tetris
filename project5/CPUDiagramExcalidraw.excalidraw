    {
      "id": "dCLeOolRvK-XDMwgbb9oQ",
      "type": "text",
      "x": 415.7180058503521,
      "y": 243.16795084313685,
      "width": 273.4480129612286,
      "height": 170.65523373054353,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 2085789214,
      "version": 833,
      "versionNonce": 526982540,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783508808427,
      "link": null,
      "locked": false,
      "text": "This depends on the MSB of the\ninstructions.\nwhich means it depends on the\ninstructions[15] to decide whether\nit comes from the ALU the\ninstructions itself\n\n0 -> A-instructions\n1 -> C-instructions",
      "fontSize": 15.169354109381645,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This depends on the MSB of the instructions.\nwhich means it depends on the instructions[15] to decide whether\nit comes from the ALU the instructions itself\n\n0 -> A-instructions\n1 -> C-instructions",
      "autoResize": false,
      "lineHeight": 1.25
    },
